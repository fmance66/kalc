        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;rounded=0;strokeColor=#6c8ebf;exitX=0.76;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="app" target="consultas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;rounded=0;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="repoAlmacen" target="baseAlmacen">
          <mxGeometry relative="1" as="geometry" />
