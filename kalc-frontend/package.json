{
  "name": "kalc-frontend",
  "version": "0.1.0",
  "private": true,
  "repository": "https://github.com/fmance66/kalc",
  "description": "Kalc en el navegador: probador de fórmulas, variables (en PostgreSQL a través de kalc-backend, o en el navegador), catálogo de funciones y ayuda.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:app": "vite",
    "start": "node scripts/dev.mjs",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "publicar": "node scripts/publicar.mjs",
    "publicar:prueba": "node scripts/publicar.mjs --prueba",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --build",
    "preversion": "npm test && npm run typecheck",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "kalc": "file:paquetes/kalc-1.7.0.tgz"
  },
  "devDependencies": {
    "@primeuix/themes": "^2.0.3",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.14.6",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "typescript": "~6.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
