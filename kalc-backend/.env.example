# Copiar como .env (no se versiona) y completar. npm start lo lee al arrancar.

# --- Base --------------------------------------------------------------------------------------
# Las variables se guardan en PostgreSQL (el almacén: la tabla motor_variables). Las consultas
# corren en PostgreSQL y, si se agrega una conexión, también en Oracle.
#
# Dos formatos. El simple, una sola base: POSTGRES_USUARIO, POSTGRES_CLAVE, POSTGRES_CONEXION y,
# opcional, POSTGRES_ESQUEMA. El de varias, con nombre, es el de abajo: lo arma db/postgres/crear.sql,
# con un usuario que escribe (kalc, para el almacén) y otro de solo lectura (kalc_lectura, para las
# consultas a los esquemas de ejemplo).
#
#   CONEXIONES             las conexiones, por nombre; cada una, POSTGRES_<NOMBRE>_* u ORACLE_<NOMBRE>_*
#   ALMACEN                dónde está motor_variables, siempre PostgreSQL (si falta, la primera)
#   CONSULTAS              dónde pueden correr las variables de consulta; la primera es la de por
#                          defecto (si falta, en todas, en el orden de CONEXIONES)
#   CONSULTA_POR_DEFECTO   opcional: dónde corre una consulta que no elige base (si falta, la
#                          primera de CONSULTAS); tiene que estar en CONSULTAS
#
# _CONEXION es host[:puerto]/base (5432 si no dice) y _ESQUEMA, opcional, el search_path (uno o
# varios, separados por coma): las tablas se nombran sin prefijo.
CONEXIONES=almacen,local
ALMACEN=almacen
CONSULTAS=local

POSTGRES_ALMACEN_USUARIO=kalc
POSTGRES_ALMACEN_CLAVE=
POSTGRES_ALMACEN_CONEXION=localhost:5432/kalc
POSTGRES_ALMACEN_ESQUEMA=kalc

POSTGRES_LOCAL_USUARIO=kalc_lectura
POSTGRES_LOCAL_CLAVE=
POSTGRES_LOCAL_CONEXION=localhost:5432/kalc
POSTGRES_LOCAL_ESQUEMA=kalc_data,prueba,hr,scott

PUERTO=7201

# --- Consultas en Oracle (opcional) -------------------------------------------------------------
# Una conexión también puede ser Oracle, solo para consultas: se agrega a CONEXIONES y a CONSULTAS,
# con las mismas variables y ORACLE_ en vez de POSTGRES_.
#
#   CONEXIONES=almacen,local,reportes
#   CONSULTAS=local,reportes
#   ORACLE_REPORTES_USUARIO=...
#   ORACLE_REPORTES_CLAVE=...
#   ORACLE_REPORTES_CONEXION=servidor:1521/servicio
#   ORACLE_REPORTES_ESQUEMA=VENTAS      opcional: las tablas sin prefijo son las de ese esquema
#
# ORACLE_<NOMBRE>_CONEXION va en una sola línea (este archivo se lee de a una), de una de estas formas:
#
# 1. host:puerto/servicio. Solo con SERVICE_NAME: no sirve si la base se identifica por SID.
#
# 2. Descriptor completo. Sirve también cuando la base se identifica por SID:
#      (DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=servidor)(PORT=1521))(CONNECT_DATA=(SID=ORCL)))
#
# 3. Alias del tnsnames.ora, con TNS_ADMIN apuntando a su carpeta. Si el alias no está, el servidor
#    dice NJS-517 con la ruta que buscó:
#      TNS_ADMIN=D:\oracle\product\12.2.0\client\network\admin
#
# NJS-116 (password verifier type 0x939) al conectar: la clave del usuario tiene el verificador de
# Oracle 10g, que el modo thin (el de por defecto) no acepta. Si reasignarle la clave no alcanza (la
# base solo genera ese verificador), usar el modo thick con un Oracle Instant Client 19 o posterior
# (Basic Light alcanza; un cliente 12.2 no sirve, da DPI-1050):
# ORACLE_CLIENTE=D:\oracle\instantclient_19_25
