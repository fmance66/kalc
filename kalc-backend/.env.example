# Copiar como .env (no se versiona) y completar. npm start lo lee al arrancar.

# --- Base --------------------------------------------------------------------------------------
# Dos formatos. El simple, una sola base: ORACLE_USUARIO, ORACLE_CLAVE, ORACLE_CONEXION (abajo) y,
# opcional, ORACLE_ESQUEMA. El de varias bases, con nombre (cada una, ORACLE_<NOMBRE>_*):
#
#   CONEXIONES=desarrollo,reportes
#   ALMACEN=desarrollo             dónde está la tabla motor_variables (si falta, la primera)
#   CONSULTAS=reportes             dónde pueden correr las variables de consulta; la primera es la
#                                  de por defecto (si falta, en todas, en el orden de CONEXIONES)
#   CONSULTA_POR_DEFECTO=reportes  opcional: dónde corre una consulta que no elige base (si falta,
#                                  la primera de CONSULTAS); tiene que estar en CONSULTAS
#   ORACLE_DESARROLLO_USUARIO=...
#   ORACLE_DESARROLLO_CLAVE=...
#   ORACLE_DESARROLLO_CONEXION=localhost:1521/FREEPDB1
#   ORACLE_REPORTES_USUARIO=...
#   ORACLE_REPORTES_CLAVE=...
#   ORACLE_REPORTES_CONEXION=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=servidor)(PORT=1521))(CONNECT_DATA=(SID=ORCL)))
#   ORACLE_REPORTES_ESQUEMA=VENTAS opcional: las tablas sin prefijo son las de ese esquema
#
# Cada _CONEXION va en una sola línea (este archivo se lee de a una), de una de las tres formas de
# abajo. Con CONEXIONES, las ORACLE_USUARIO/CLAVE/CONEXION/CONSULTAS_* no se usan.
#
# Una conexión también puede ser PostgreSQL, solo para consultas (el almacén es siempre Oracle): las
# mismas variables con POSTGRES_ en vez de ORACLE_. _CONEXION es host[:puerto]/base (5432 si no
# dice) y _ESQUEMA, opcional, el search_path (uno o varios, separados por coma). La base de ejemplo
# se crea con db/postgres/crear.sql (ver el README). Con local primera en CONSULTAS, las variables
# de ejemplo de kalc-frontend (las del esquema juzgado) corren ahí:
#   CONEXIONES=desarrollo,local
#   CONSULTAS=local,desarrollo
#   POSTGRES_LOCAL_USUARIO=kalc_lectura
#   POSTGRES_LOCAL_CLAVE=...
#   POSTGRES_LOCAL_CONEXION=localhost:5432/kalc
#   POSTGRES_LOCAL_ESQUEMA=juzgado,prueba,hr,scott
ORACLE_USUARIO=
ORACLE_CLAVE=

# ORACLE_CONEXION, una de estas tres formas:
#
# 1. Alias del tnsnames.ora, con TNS_ADMIN apuntando a su carpeta:
#      ORACLE_CONEXION=MI_BASE
#      TNS_ADMIN=D:\oracle\product\12.2.0\client\network\admin
#    Si el alias no está, el servidor dice NJS-517 con la ruta que buscó.
#
# 2. Descriptor completo, en una línea. Sirve también cuando la base se identifica por SID:
#      ORACLE_CONEXION=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=servidor)(PORT=1521))(CONNECT_DATA=(SID=ORCL)))
#
# 3. host:puerto/servicio. Solo con SERVICE_NAME: no sirve si la base se identifica por SID:
#      ORACLE_CONEXION=servidor:1521/servicio
ORACLE_CONEXION=

# NJS-116 (password verifier type 0x939) al conectar: la clave del usuario tiene el verificador de
# Oracle 10g, que el modo thin (el de por defecto) no acepta. Si reasignarle la clave no alcanza (la
# base solo genera ese verificador), usar el modo thick con un Oracle Instant
# Client 19 o posterior (Basic Light alcanza; un cliente 12.2 no sirve, da DPI-1050):
# ORACLE_CLIENTE=D:\oracle\instantclient_19_25

PUERTO=7201

# --- Variables de consulta (opcional) -----------------------------------------------------------
# El SELECT de una variable de consulta corre en una transacción de solo lectura, pero conviene
# además un usuario que solo pueda leer (con permisos o sinónimos sobre lo que se quiera consultar).
# Sin esto, las consultas corren con ORACLE_USUARIO. ORACLE_CONSULTAS_CONEXION es opcional: si
# falta, usa ORACLE_CONEXION.
# ORACLE_CONSULTAS_USUARIO=
# ORACLE_CONSULTAS_CLAVE=
# ORACLE_CONSULTAS_CONEXION=
# ORACLE_CONSULTAS_ESQUEMA=
# Con CONEXIONES, lo mismo es declarar una conexión con ese usuario y nombrarla en CONSULTAS.
